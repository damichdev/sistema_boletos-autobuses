<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana de alta y edición de empleados. Licencia y vigencia solo se habilitan para choferes. -->
<StackPane styleClass="ventana-sombra" fx:controller="michelle.zaca_bus.controller.PersonalController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <VBox styleClass="ventana" prefWidth="660" maxWidth="660" maxHeight="-Infinity">
        <HBox styleClass="ventana-titulo" alignment="CENTER_LEFT">
            <Label fx:id="lblTitulo" text="Nuevo empleado" styleClass="ventana-titulo-texto"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="×" styleClass="boton, cerrar-x" onAction="#cerrar"/>
        </HBox>
        <VBox styleClass="ventana-cuerpo" spacing="16">
            <GridPane hgap="14" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="NOMBRE(S)" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtNombre" promptText="Nombre(s)" styleClass="text-field, text-input"/>
                </VBox>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="APELLIDO PATERNO" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtApPaterno" promptText="Apellido paterno" styleClass="text-field, text-input"/>
                </VBox>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="APELLIDO MATERNO" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtApMaterno" promptText="Apellido materno" styleClass="text-field, text-input"/>
                </VBox>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="CURP" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtCurp" promptText="CURP" styleClass="text-field, text-input, mono"/>
                </VBox>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="TELÉFONO" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtTelefono" promptText="10 dígitos" styleClass="text-field, text-input, mono"/>
                </VBox>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="PUESTO" styleClass="campo-etiqueta"/>
                    <ComboBox fx:id="cbPuesto" promptText="Puesto" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="LICENCIA (CHOFERES)" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtLicencia" promptText="Licencia" styleClass="text-field, text-input, mono"/>
                </VBox>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Label text="VIGENCIA DE LICENCIA" styleClass="campo-etiqueta"/>
                    <DatePicker fx:id="dpVigencia" promptText="aaaa-mm-dd" maxWidth="Infinity"/>
                </VBox>
            </GridPane>
            <Label fx:id="lblError" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
        </VBox>
        <HBox styleClass="ventana-pie" spacing="10" alignment="CENTER_RIGHT">
            <Button text="Cancelar" styleClass="boton, boton-secundario" onAction="#cerrar"/>
            <Button text="Guardar" styleClass="boton, boton-primario" onAction="#guardar"/>
        </HBox>
    </VBox>
</StackPane>
