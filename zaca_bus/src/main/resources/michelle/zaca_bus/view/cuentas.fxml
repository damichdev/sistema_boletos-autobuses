<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="pagina" fx:controller="michelle.zaca_bus.controller.admin_controller.CuentasController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <fx:include source="barra-administrador.fxml"/>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
            <VBox styleClass="contenido" spacing="20">
                <VBox spacing="2">
                    <Label text="Cuentas de usuario" styleClass="titulo-pagina"/>
                    <Label text="Una cuenta personal por empleado. Todo lo que haga queda registrado a su nombre." styleClass="texto-sec"/>
                </VBox>
                <Label fx:id="lblMensaje" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
                <VBox styleClass="tarjeta">
                    <HBox styleClass="tarjeta-cabeza" spacing="10" alignment="CENTER_LEFT">
                        <Label text="Cuentas" styleClass="tarjeta-titulo"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtBuscar" promptText="Usuario, nombre, rol o sede…" styleClass="text-field, text-input, buscador"/>
                        <Button text="+ Nueva cuenta" styleClass="boton, boton-primario" onAction="#nuevaCuenta"/>
                    </HBox>
                    <TableView fx:id="tabla" styleClass="table-view, tabla" VBox.vgrow="ALWAYS" prefHeight="420" minHeight="420">
                        <columns>
                            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="130" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colNombre" text="Nombre completo" prefWidth="220" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colRol" text="Rol" prefWidth="120" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colSede" text="Sede" prefWidth="130" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="90" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAcciones" prefWidth="180" sortable="false" reorderable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Aún no hay cuentas." styleClass="tabla-vacia"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
