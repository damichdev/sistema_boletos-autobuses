<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<!-- Barra lateral del administrador: se incluye en cada pantalla con fx:include. -->
<VBox styleClass="lateral" spacing="4" minWidth="230" prefWidth="230" maxWidth="230" fx:controller="michelle.zaca_bus.controller.VistaController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <HBox styleClass="marca-caja" alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="marca-barra"/>
        <Label text="ZACA" styleClass="marca"/>
    </HBox>
    <Label text="ADMINISTRACIÓN" styleClass="seccion-lateral"/>
    <Button text="Rutas" id="rutas" onAction="#irA" styleClass="nav-boton" maxWidth="Infinity" graphicTextGap="12">
        <graphic>
            <SVGPath content="M6 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM18 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM8 19h7a3.5 3.5 0 0 0 0-7H9a3.5 3.5 0 0 1 0-7h7" styleClass="icono"/>
        </graphic>
    </Button>
    <Button text="Unidades" id="unidades" onAction="#irA" styleClass="nav-boton" maxWidth="Infinity" graphicTextGap="12">
        <graphic>
            <SVGPath content="M5 3h14a1 1 0 0 1 1 1v12H4V4a1 1 0 0 1 1-1zM4 10h16M7 16v3M17 16v3M8 13h.01M16 13h.01" styleClass="icono"/>
        </graphic>
    </Button>
    <Button text="Taquillas" id="taquillas" onAction="#irA" styleClass="nav-boton" maxWidth="Infinity" graphicTextGap="12">
        <graphic>
            <SVGPath content="M3 21h18M5 21V8l7-4 7 4v13M9 21v-5h6v5" styleClass="icono"/>
        </graphic>
    </Button>
    <Button text="Personal" id="personal" onAction="#irA" styleClass="nav-boton" maxWidth="Infinity" graphicTextGap="12">
        <graphic>
            <SVGPath content="M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM2 21c0-4 3-6 7-6s7 2 7 6M16 4.5a3.5 3.5 0 0 1 0 7M18 15c2.5.6 4 2.5 4 6" styleClass="icono"/>
        </graphic>
    </Button>
    <Button text="Cuentas" id="cuentas" onAction="#irA" styleClass="nav-boton" maxWidth="Infinity" graphicTextGap="12">
        <graphic>
            <SVGPath content="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21c0-4 3.5-6 8-6s8 2 8 6M17 3l1.5 1.5L21 2" styleClass="icono"/>
        </graphic>
    </Button>
    <Region VBox.vgrow="ALWAYS"/>
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="nodo">
        <Circle radius="4" styleClass="nodo-punto"/>
        <Label text="Nodo" styleClass="nodo-texto"/>
    </HBox>
    <VBox styleClass="quien" spacing="1">
        <Label text="" styleClass="quien-nombre"/>
        <Label text="" styleClass="quien-detalle"/>
    </VBox>
    <Button text="Salir" id="login" onAction="#irA" styleClass="boton-salir" maxWidth="Infinity" graphicTextGap="8">
        <graphic>
            <SVGPath content="M9 4H5v16h4M16 8l4 4-4 4M20 12H9" styleClass="icono"/>
        </graphic>
    </Button>
</VBox>
