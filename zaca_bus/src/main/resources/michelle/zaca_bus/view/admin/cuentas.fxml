<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Filtros (ciudad, terminal, búsqueda) dentro de la tarjeta; la ciudad espera a que Personal guarde la terminal. -->
<BorderPane styleClass="pagina" fx:controller="michelle.zaca_bus.controller.admin.CuentasController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <fx:include source="barra-administrador.fxml"/>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
            <VBox styleClass="contenido" spacing="20">
                <VBox spacing="2">
                    <Label text="Cuentas de usuario" styleClass="titulo-pagina"/>
                    <Label text="Una cuenta personal por empleado. Todo lo que haga queda registrado a su nombre." styleClass="texto-sec"/>
                </VBox>
                <Label fx:id="lblMensaje" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
                <VBox styleClass="tarjeta">
                    <HBox styleClass="tarjeta-cabeza" spacing="16" alignment="BOTTOM_LEFT">
                        <VBox spacing="6">
                            <Label text="Ciudad:" styleClass="campo-etiqueta"/>
                            <ComboBox fx:id="cbCiudad" prefWidth="190"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Terminal / Taller:" styleClass="campo-etiqueta"/>
                            <ComboBox fx:id="cbTerminalFiltro" prefWidth="260"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Buscar:" styleClass="campo-etiqueta"/>
                            <TextField fx:id="txtBuscar" promptText="Usuario, nombre…" styleClass="text-field, text-input, buscador"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Nueva cuenta" styleClass="boton, boton-primario" onAction="#nuevaCuenta"/>
                    </HBox>
                    <TableView fx:id="tablaCuentas" styleClass="table-view, tabla" VBox.vgrow="ALWAYS" prefHeight="420" minHeight="420">
                        <columns>
                            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="110" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colNombreCuenta" text="Nombre Completo" prefWidth="200" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colRol" text="Rol" prefWidth="110" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colSede" text="Sede / Asignación" prefWidth="150" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="80" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAccionesCuenta" text="Acciones" prefWidth="190" minWidth="190" sortable="false" reorderable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Aún no hay cuentas." styleClass="tabla-vacia"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
