<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Talleres de mantenimiento (base externa por FDW): lista con filtro por ciudad y búsqueda. -->
<BorderPane styleClass="pagina" fx:controller="michelle.zaca_bus.controller.admin.TalleresController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <fx:include source="barra-administrador.fxml"/>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
            <VBox styleClass="contenido" spacing="20">
                <VBox spacing="2">
                    <Label text="Taller" styleClass="titulo-pagina"/>
                    <Label text="Gestión de talleres de mantenimiento y asignación de encargados." styleClass="texto-sec"/>
                </VBox>
                <Label fx:id="lblError" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
                <HBox spacing="16" alignment="BOTTOM_LEFT">
                    <VBox spacing="4">
                        <Label text="Ciudad:" styleClass="campo-etiqueta"/>
                        <ComboBox fx:id="cbCiudad" prefWidth="220"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Buscar:" styleClass="campo-etiqueta"/>
                        <TextField fx:id="txtBuscar" promptText="Nombre, encargado..." maxWidth="320"/>
                    </VBox>
                    <Button text="+ Nuevo taller" styleClass="boton, boton-primario" onAction="#nuevoTaller"/>
                </HBox>
                <VBox styleClass="tarjeta">
                    <TableView fx:id="tabla" styleClass="table-view, tabla" VBox.vgrow="ALWAYS" prefHeight="420" minHeight="420">
                        <columns>
                            <TableColumn fx:id="colClave" text="Clave" prefWidth="70" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colNombre" text="Nombre del Taller" prefWidth="160" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="190" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAutobuses" text="Autobuses" prefWidth="110" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colMecanicos" text="Mecánicos Activos" prefWidth="110" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colEncargado" text="Encargado" prefWidth="130" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="70" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="260" minWidth="260" sortable="false" reorderable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Aún no hay talleres." styleClass="tabla-vacia"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
