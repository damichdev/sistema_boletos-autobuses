<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Ver acomodos: configuraciones de asientos registradas (tipo de servicio, distribución y capacidad). -->
<StackPane styleClass="ventana-sombra" fx:controller="michelle.zaca_bus.controller.admin.UnidadesController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <VBox styleClass="ventana" prefWidth="860" maxWidth="860" maxHeight="-Infinity">
        <HBox styleClass="ventana-titulo" alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="2">
                <Label text="VER ACOMODOS / PLANTILLAS" styleClass="ventana-titulo-texto"/>
                <Label text="Listado de configuraciones de asientos disponibles para las unidades." styleClass="texto-sec"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Nuevo acomodo" styleClass="boton, boton-primario" onAction="#nuevoAcomodo"/>
        </HBox>
        <VBox styleClass="ventana-cuerpo" spacing="10">
            <Label fx:id="lblMensaje" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
            <TableView fx:id="tablaAcomodos" styleClass="table-view, tabla" prefHeight="300" minHeight="300">
                <columns>
                    <TableColumn fx:id="colServicio" text="Tipo de servicio" prefWidth="260" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colDistribucion" text="Distribución" prefWidth="260" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colCapacidad" text="Capacidad" prefWidth="260" sortable="false" reorderable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Aún no hay acomodos." styleClass="tabla-vacia"/>
                </placeholder>
            </TableView>
        </VBox>
        <HBox styleClass="ventana-pie" alignment="CENTER_RIGHT">
            <Button fx:id="btnCerrar" text="Cerrar" styleClass="boton, boton-secundario" onAction="#cerrarAcomodo"/>
        </HBox>
    </VBox>
</StackPane>
