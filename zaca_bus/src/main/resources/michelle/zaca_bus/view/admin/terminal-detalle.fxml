<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Ver taquillas de la terminal: tabla con rango y uso de folios, estado y acciones. -->
<StackPane styleClass="ventana-sombra" fx:controller="michelle.zaca_bus.controller.admin.TerminalesController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <VBox styleClass="ventana" prefWidth="820" maxWidth="820" maxHeight="-Infinity">
        <HBox styleClass="ventana-titulo" alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="lblTitulo" text="VER TAQUILLAS DE LA TERMINAL" styleClass="ventana-titulo-texto"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Nueva taquilla" styleClass="boton, boton-primario" onAction="#nuevaTaquilla"/>
        </HBox>
        <VBox styleClass="ventana-cuerpo" spacing="10">
            <Label fx:id="lblMensaje" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
            <TableView fx:id="tabla" styleClass="table-view, tabla" prefHeight="300" minHeight="300">
                <columns>
                    <TableColumn fx:id="colNumero" text="Taquilla" prefWidth="70" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colIdentificador" text="Identificador" prefWidth="110" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colPrefijo" text="Prefijo de Folios" prefWidth="110" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colFolios" text="Folios Usados / Rango" prefWidth="170" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colEstatus" text="Estatus" prefWidth="80" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="190" minWidth="190" sortable="false" reorderable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="Esta terminal aún no tiene taquillas." styleClass="tabla-vacia"/>
                </placeholder>
            </TableView>
        </VBox>
        <HBox styleClass="ventana-pie" alignment="CENTER_RIGHT">
            <Button text="Cerrar" styleClass="boton, boton-secundario" onAction="#cerrarTaquillas"/>
        </HBox>
    </VBox>
</StackPane>
