<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Órdenes de taller en modo auditoría (taller_db por FDW). "Nueva orden" queda deshabilitado, como en el diseño. -->
<BorderPane styleClass="pagina" fx:controller="michelle.zaca_bus.controller.admin.OrdenesTallerController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <fx:include source="barra-administrador.fxml"/>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
            <VBox styleClass="contenido" spacing="20">
                <VBox spacing="2">
                    <Label text="Órdenes de taller (Auditoría)" styleClass="titulo-pagina"/>
                    <Label text="Historial, mantenimiento y diagnóstico de reparaciones de toda la flota de la empresa." styleClass="texto-sec"/>
                </VBox>
                <Label fx:id="lblError" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
                <HBox spacing="16" alignment="BOTTOM_LEFT">
                    <VBox spacing="4">
                        <Label text="Taller:" styleClass="campo-etiqueta"/>
                        <ComboBox fx:id="cbTaller" prefWidth="280"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Estado de la Orden:" styleClass="campo-etiqueta"/>
                        <ComboBox fx:id="cbEstado" prefWidth="170"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Buscar:" styleClass="campo-etiqueta"/>
                        <TextField fx:id="txtBuscar" promptText="No. de Orden, Unidad o Mecánico..." maxWidth="340"/>
                    </VBox>
                    <Button text="+ Nueva orden" styleClass="boton, boton-primario" disable="true"/>
                </HBox>
                <VBox styleClass="tarjeta">
                    <TableView fx:id="tabla" styleClass="table-view, tabla" VBox.vgrow="ALWAYS" prefHeight="420" minHeight="420">
                        <columns>
                            <TableColumn fx:id="colOrden" text="No. Orden" prefWidth="110" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="150" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colServicio" text="Tipo de Servicio" prefWidth="170" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colMecanico" text="Mecánico Asignado" prefWidth="140" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colIngreso" text="Fecha Ingreso" prefWidth="130" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="120" minWidth="120" sortable="false" reorderable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No hay órdenes con ese filtro." styleClass="tabla-vacia"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
