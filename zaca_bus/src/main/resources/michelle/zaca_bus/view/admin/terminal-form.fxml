<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana de terminal: una por ciudad (al crear, solo ciudades sin terminal; al editar, la ciudad queda fija). Solo diseño: el guardado se conecta en la fase de backend. -->
<StackPane styleClass="ventana-sombra" fx:controller="michelle.zaca_bus.controller.admin.TerminalesController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <VBox styleClass="ventana" prefWidth="720" maxWidth="720" maxHeight="-Infinity">
        <HBox styleClass="ventana-titulo" alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label fx:id="lblTitulo" text="NUEVA TERMINAL" styleClass="ventana-titulo-texto"/>
                <Label text="Registre la terminal de una ciudad. Cada ciudad tiene una sola terminal." styleClass="texto-sec"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="×" styleClass="boton, cerrar-x" onAction="#cerrar"/>
        </HBox>
        <VBox styleClass="ventana-cuerpo" spacing="16">
            <GridPane hgap="18" vgap="14">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="CIUDAD" styleClass="campo-etiqueta"/>
                    <HBox spacing="8">
                        <ComboBox fx:id="cbCiudad" promptText="Ciudad" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnNuevaCiudad" text="+" styleClass="boton, boton-secundario" minWidth="40" onAction="#nuevaCiudad"/>
                    </HBox>
                    <Label fx:id="lblNotaCiudad" styleClass="texto-sec" wrapText="true"/>
                </VBox>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.rowSpan="2">
                    <Label text="DIRECCIÓN" styleClass="campo-etiqueta"/>
                    <TextArea fx:id="txtDireccion" prefRowCount="4" wrapText="true"/>
                    <Label text="Ubicación física exacta de la terminal" styleClass="texto-sec"/>
                </VBox>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="CLAVE / IDENTIFICADOR" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtClave" promptText="TAP-04" styleClass="text-field, text-input, mono"/>
                    <Label text="Prefijo único para reportes y folios (Ej: TAP-04)" styleClass="texto-sec"/>
                </VBox>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="NOMBRE DE LA SUCURSAL" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtSucursal" promptText="Terminal Norte Express" styleClass="text-field, text-input"/>
                    <Label text="Nombre identificativo (Ej: Módulo Plaza Comercial)" styleClass="texto-sec"/>
                </VBox>
                <VBox spacing="6" styleClass="campo" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="TELÉFONO DE CONTACTO (OPCIONAL)" styleClass="campo-etiqueta"/>
                    <TextField fx:id="txtTelefono" promptText="9621234567" styleClass="text-field, text-input, mono"/>
                    <Label text="Número telefónico de la sucursal" styleClass="texto-sec"/>
                </VBox>
            </GridPane>
            <Label fx:id="lblError" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
        </VBox>
        <HBox styleClass="ventana-pie" spacing="10" alignment="CENTER_RIGHT">
            <Button text="Cancelar" styleClass="boton, boton-secundario" onAction="#cerrar"/>
            <Button text="Guardar terminal" styleClass="boton, boton-primario" onAction="#guardar"/>
        </HBox>
    </VBox>
</StackPane>
