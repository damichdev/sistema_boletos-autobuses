<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Filtros (ciudad, terminal, puesto) y tabla de empleados. Ciudad y terminal esperan a que el empleado guarde su terminal. -->
<BorderPane styleClass="pagina" fx:controller="michelle.zaca_bus.controller.admin.PersonalListaController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <fx:include source="barra-administrador.fxml"/>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
            <VBox styleClass="contenido" spacing="20">
                <VBox spacing="2">
                    <Label text="Personal" styleClass="titulo-pagina"/>
                    <Label text="Gestión de empleados, choferes y mecánicos de la red de transporte." styleClass="texto-sec"/>
                </VBox>
                <Label fx:id="lblMensaje" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
                <HBox spacing="16" alignment="BOTTOM_LEFT">
                    <VBox spacing="6">
                        <Label text="Ciudad:" styleClass="campo-etiqueta"/>
                        <ComboBox fx:id="cbCiudad" prefWidth="200"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Terminal:" styleClass="campo-etiqueta"/>
                        <ComboBox fx:id="cbTerminalFiltro" prefWidth="260"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Puesto:" styleClass="campo-etiqueta"/>
                        <ComboBox fx:id="cbPuestoFiltro" prefWidth="200"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Nuevo empleado" styleClass="boton, boton-primario" onAction="#nuevoEmpleado"/>
                </HBox>
                <VBox styleClass="tarjeta">
                    <TableView fx:id="tabla" styleClass="table-view, tabla" VBox.vgrow="ALWAYS" prefHeight="420" minHeight="420">
                        <columns>
                            <TableColumn fx:id="colNombre" text="Nombre Completo" prefWidth="190" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colCurp" text="CURP" prefWidth="170" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colPuesto" text="Puesto" prefWidth="110" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAsignacion" text="Asignación" prefWidth="120" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="220" minWidth="220" sortable="false" reorderable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Sin personal para ese filtro." styleClass="tabla-vacia"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
