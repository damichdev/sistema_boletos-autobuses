<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<!-- Un solo QR ampara todos los asientos del boleto. El QR real lo dibuja el controlador. -->
<StackPane styleClass="ventana-sombra" fx:controller="michelle.zaca_bus.controller.VistaController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <VBox styleClass="ventana" prefWidth="600" maxWidth="600" maxHeight="-Infinity">
        <HBox styleClass="ventana-titulo" alignment="CENTER_LEFT">
            <Label text="Boleto" styleClass="ventana-titulo-texto"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="×" styleClass="boton, cerrar-x" onAction="#cerrar"/>
        </HBox>
        <VBox styleClass="ventana-cuerpo" spacing="16">
            <HBox styleClass="ticket" spacing="16">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="ZACA · BOLETO" styleClass="ticket-marca"/>
                    <Label text="Folio:" styleClass="mono"/>
                    <Label text="Ruta:" styleClass="mono"/>
                    <Label text="Salida:" styleClass="mono"/>
                    <Label text="Unidad:" styleClass="mono"/>
                    <Label text="Titular:" styleClass="mono"/>
                    <Label text="Asientos" styleClass="texto-sec, mono"/>
                    <Label text="" styleClass="ticket-asientos"/>
                    <Label text="Total $0.00 · Recibido $0.00 · Cambio $0.00" styleClass="mono"/>
                    <Label text="Atendió:" styleClass="texto-sec, mono"/>
                </VBox>
                <VBox alignment="TOP_CENTER">
                    <StackPane>
                        <Rectangle width="120" height="120" styleClass="qr"/>
                        <Label text="QR" styleClass="qr-texto"/>
                    </StackPane>
                </VBox>
            </HBox>
        </VBox>
        <HBox styleClass="ventana-pie" spacing="10" alignment="CENTER_RIGHT">
            <Button text="Reimprimir" styleClass="boton, boton-secundario" onAction="#cerrar"/>
            <Button text="Nueva venta" styleClass="boton, boton-primario" onAction="#irA" id="venta"/>
        </HBox>
    </VBox>
</StackPane>
