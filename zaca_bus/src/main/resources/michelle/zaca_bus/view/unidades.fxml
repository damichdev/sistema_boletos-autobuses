<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- La columna "Estado" (en taller) se agrega cuando exista la consulta a taller_db por FDW. -->
<BorderPane styleClass="pagina" fx:controller="michelle.zaca_bus.controller.admin_controller.UnidadesController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <fx:include source="barra-administrador.fxml"/>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
            <VBox styleClass="contenido" spacing="20">
                <VBox spacing="2">
                    <Label text="Unidades" styleClass="titulo-pagina"/>
                    <Label text="Autobuses de la flota con su acomodo de asientos." styleClass="texto-sec"/>
                </VBox>
                <Label fx:id="lblMensaje" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
                <VBox styleClass="tarjeta">
                    <HBox styleClass="tarjeta-cabeza" spacing="10" alignment="CENTER_LEFT">
                        <Label text="Unidades" styleClass="tarjeta-titulo"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtBuscar" promptText="Placa o modelo…" styleClass="text-field, text-input, buscador"/>
                        <Button text="+ Nueva unidad" styleClass="boton, boton-primario" onAction="#nuevaUnidad"/>
                    </HBox>
                    <TableView fx:id="tabla" styleClass="table-view, tabla" VBox.vgrow="ALWAYS" prefHeight="420" minHeight="420">
                        <columns>
                            <TableColumn fx:id="colPlaca" text="Placa" prefWidth="100" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colModelo" text="Modelo" prefWidth="180" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAnio" text="Año" prefWidth="70" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="100" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAcomodo" text="Acomodo" prefWidth="170" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colKm" text="Kilometraje" prefWidth="110" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAcciones" prefWidth="90" sortable="false" reorderable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Aún no hay unidades." styleClass="tabla-vacia"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
