<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<!-- Barra lateral del taquillero: se incluye en cada pantalla con fx:include. -->
<VBox styleClass="lateral" spacing="4" minWidth="230" prefWidth="230" maxWidth="230" fx:controller="michelle.zaca_bus.controller.VistaController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <HBox styleClass="marca-caja" alignment="CENTER_LEFT" spacing="10">
        <Region styleClass="marca-barra"/>
        <Label text="ZACA" styleClass="marca"/>
    </HBox>
    <Label text="TAQUILLA" styleClass="seccion-lateral"/>
    <Button text="Venta" id="venta" onAction="#irA" styleClass="nav-boton" maxWidth="Infinity" graphicTextGap="12">
        <graphic>
            <SVGPath content="M4 7h16v3a2 2 0 0 0 0 4v3H4v-3a2 2 0 0 0 0-4zM14 7v10" styleClass="icono"/>
        </graphic>
    </Button>
    <Button text="Boletos vendidos" id="boletos" onAction="#irA" styleClass="nav-boton" maxWidth="Infinity" graphicTextGap="12">
        <graphic>
            <SVGPath content="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01" styleClass="icono"/>
        </graphic>
    </Button>
    <Region VBox.vgrow="ALWAYS"/>
    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="nodo">
        <Circle radius="4" styleClass="nodo-punto"/>
        <Label text="Nodo" styleClass="nodo-texto"/>
    </HBox>
    <VBox styleClass="quien" spacing="1">
        <Label text="" styleClass="quien-nombre"/>
        <Label text="" styleClass="quien-detalle"/>
    </VBox>
    <Button text="Cerrar turno y salir" id="login" onAction="#irA" styleClass="boton-salir" maxWidth="Infinity" graphicTextGap="8">
        <graphic>
            <SVGPath content="M9 4H5v16h4M16 8l4 4-4 4M20 12H9" styleClass="icono"/>
        </graphic>
    </Button>
</VBox>
