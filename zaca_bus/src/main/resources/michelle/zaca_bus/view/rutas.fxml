<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="pagina" fx:controller="michelle.zaca_bus.controller.RutasController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <fx:include source="barra-administrador.fxml"/>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
            <VBox styleClass="contenido" spacing="20">
                <VBox spacing="2">
                    <Label text="Rutas" styleClass="titulo-pagina"/>
                    <Label text="El molde del negocio: paradas en orden y el precio de cada tramo." styleClass="texto-sec"/>
                </VBox>
                <Label fx:id="lblMensaje" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
                <VBox styleClass="tarjeta">
                    <HBox styleClass="tarjeta-cabeza" spacing="10" alignment="CENTER_LEFT">
                        <Label text="Rutas" styleClass="tarjeta-titulo"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtBuscar" promptText="Buscar…" styleClass="text-field, text-input, buscador"/>
                        <Button text="+ Nueva ruta" styleClass="boton, boton-primario" onAction="#nuevaRuta"/>
                    </HBox>
                    <TableView fx:id="tabla" styleClass="table-view, tabla" VBox.vgrow="ALWAYS" prefHeight="420" minHeight="420">
                        <columns>
                            <TableColumn fx:id="colNombre" text="Ruta" prefWidth="220" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colServicio" text="Servicio" prefWidth="100" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colParadas" text="Paradas" prefWidth="320" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colDistancia" text="Distancia" prefWidth="90" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colPrecio" text="Origen a destino" prefWidth="130" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colAcciones" prefWidth="90" sortable="false" reorderable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Aún no hay rutas." styleClass="tabla-vacia"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
