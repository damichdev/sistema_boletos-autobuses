<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="ventana-sombra" fx:controller="michelle.zaca_bus.controller.taquillero.VentaController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <VBox styleClass="ventana" prefWidth="560" maxWidth="560" maxHeight="-Infinity">
        <HBox styleClass="ventana-titulo" alignment="CENTER_LEFT">
            <Label text="Cancelar boleto" styleClass="ventana-titulo-texto"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="×" styleClass="boton, cerrar-x" onAction="#cerrar"/>
        </HBox>
        <VBox styleClass="ventana-cuerpo" spacing="16">
            <Label text="Marque los asientos que se cancelan; quedan libres para venderse de nuevo." styleClass="texto" wrapText="true"/>
            <VBox fx:id="boxAsientos" spacing="6"/>
            <HBox styleClass="devolver" alignment="BASELINE_LEFT">
                <Label text="Devolver al cliente" styleClass="texto-sec"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblDevolver" text="\$0.00" styleClass="total-monto"/>
            </HBox>
            <Label fx:id="lblError" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
        </VBox>
        <HBox styleClass="ventana-pie" spacing="10" alignment="CENTER_RIGHT">
            <Button text="No, regresar" styleClass="boton, boton-secundario" onAction="#cerrar"/>
            <Button text="Cancelar asientos y devolver" styleClass="boton, boton-peligro" onAction="#confirmarCancelacion"/>
        </HBox>
    </VBox>
</StackPane>
