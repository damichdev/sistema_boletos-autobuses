<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Un boleto por asiento (folio, pasajero y QR propios); los arma VentaController.prepararTicket. -->
<StackPane styleClass="ventana-sombra" fx:controller="michelle.zaca_bus.controller.taquillero.VentaController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <VBox styleClass="ventana" prefWidth="600" maxWidth="600" maxHeight="-Infinity">
        <HBox styleClass="ventana-titulo" alignment="CENTER_LEFT">
            <Label text="Boletos" styleClass="ventana-titulo-texto"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="×" styleClass="boton, cerrar-x" onAction="#cerrar"/>
        </HBox>
        <VBox styleClass="ventana-cuerpo" spacing="12">
            <ScrollPane fitToWidth="true" prefHeight="420" maxHeight="420">
                <VBox fx:id="boxPases" spacing="12"/>
            </ScrollPane>
            <Label fx:id="lblTotales" styleClass="mono"/>
        </VBox>
        <HBox styleClass="ventana-pie" spacing="10" alignment="CENTER_RIGHT">
            <Button text="Imprimir" styleClass="boton, boton-secundario" onAction="#imprimir"/>
            <Button text="Nueva venta" styleClass="boton, boton-primario" onAction="#irA" id="venta"/>
        </HBox>
    </VBox>
</StackPane>
