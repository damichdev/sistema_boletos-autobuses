<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Vista de tableta. La escala se elige a mano hasta que el login diga la terminal del despachador. -->
<BorderPane styleClass="pagina, tableta" fx:controller="michelle.zaca_bus.controller.despachador_controller.ManifiestoController" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1">
    <left>
        <fx:include source="barra-despachador.fxml"/>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
            <VBox styleClass="contenido" spacing="20">
                <VBox spacing="2">
                    <Label text="Manifiesto" styleClass="titulo-pagina"/>
                    <Label text="Solo los pasajeros que deben subir en esta escala, no el viaje completo." styleClass="texto-sec"/>
                </VBox>
                <Label fx:id="lblMensaje" styleClass="alerta, alerta-error" maxWidth="Infinity" wrapText="true" visible="false" managed="false"/>
                <HBox spacing="14" alignment="BOTTOM_LEFT">
                    <VBox spacing="6" styleClass="campo" HBox.hgrow="ALWAYS">
                        <Label text="SALIDA" styleClass="campo-etiqueta"/>
                        <ComboBox fx:id="cbSalida" promptText="Elija la salida" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" styleClass="campo" minWidth="260">
                        <Label text="ESCALA" styleClass="campo-etiqueta"/>
                        <ComboBox fx:id="cbEscala" promptText="Elija la escala" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
                <HBox spacing="14" alignment="BOTTOM_LEFT">
                    <VBox styleClass="dato" minWidth="170">
                        <Label text="SALE DE LA ESCALA" styleClass="campo-etiqueta"/>
                        <Label fx:id="lblHora" styleClass="dato-grande"/>
                    </VBox>
                    <VBox styleClass="dato" minWidth="230">
                        <Label text="ABORDARON" styleClass="campo-etiqueta"/>
                        <Label fx:id="lblAbordaron" text="0 de 0 pasajeros" styleClass="dato-grande"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Marcar en ruta" styleClass="boton, boton-primario, boton-grande" onAction="#marcarEnRuta"/>
                </HBox>
                <VBox styleClass="tarjeta">
                    <HBox styleClass="tarjeta-cabeza" spacing="10" alignment="CENTER_LEFT">
                        <Label text="Pasajeros que suben en esta escala" styleClass="tarjeta-titulo"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtBuscar" promptText="Titular, asiento o folio…" styleClass="text-field, text-input, buscador"/>
                    </HBox>
                    <TableView fx:id="tabla" styleClass="table-view, tabla" VBox.vgrow="ALWAYS" prefHeight="420" minHeight="420">
                        <columns>
                            <TableColumn fx:id="colAsiento" text="Asiento" prefWidth="80" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colTitular" text="Titular" prefWidth="220" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colDestino" text="Destino" prefWidth="160" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colTarifa" text="Tarifa" prefWidth="100" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colFolio" text="Folio" prefWidth="110" sortable="false" reorderable="false"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="130" sortable="false" reorderable="false"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Nadie sube en esta escala." styleClass="tabla-vacia"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
